# Sanchez Custom Boxing — environment variables.
# PLACEHOLDERS ONLY. Never commit real values. Production secrets live in Vercel env vars (rotated).
# Anything marked TODO(business) is waiting on a decision in docs/TODO-business.md.

# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Commerce / domain ─────────────────────────────────────────────────────────
# TODO(business): deposit % for custom work is undecided (spec 04 §19.1). No default: checkout fails loudly if unset.
DEPOSIT_PERCENT=
# half-even (banker's, default) | half-up — see docs/decisions/0002-rounding-mode.md
DEPOSIT_ROUNDING=half-even
# TODO(business): launch currencies (spec 04 §19.3). Subset of AUD,AED,SGD,GBP,USD.
ENABLED_CURRENCIES=AUD,AED,SGD,GBP,USD
DEFAULT_CURRENCY=AUD
# HMAC key for /order/[token] links. >= 32 chars. Generate: openssl rand -base64 48
ORDER_LINK_SECRET=replace-with-at-least-32-random-characters
# Order-link lifetime in days
ORDER_LINK_TTL_DAYS=180

# Dev only (ignored in production): price with a SYNTHETIC test book so the funnel can be exercised before real prices exist (business TODO #23).
TEST_PRICES=0

# ── Stripe ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
# 3DS enforced above this amount (minor units, per spec 04 §7.2 Radar rules). TODO(business): threshold.
STRIPE_3DS_THRESHOLD_MINOR=

# ── Database / CMS ────────────────────────────────────────────────────────────
# TODO(business): Payload host — Vercel + Neon, or a single VPS (spec 04 §19.4)
DATABASE_URL=postgres://user:password@localhost:5432/sanchez
PAYLOAD_SECRET=replace-with-a-long-random-string

# ── Media ─────────────────────────────────────────────────────────────────────
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
# Storage: pick ONE of Vercel Blob or Cloudflare R2
BLOB_READ_WRITE_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=
R2_BUCKET_PRIVATE_UPLOADS=
NEXT_PUBLIC_ASSET_CDN_URL=
# Upload hardening (spec 04 §12)
UPLOAD_MAX_BYTES=20971520
MALWARE_SCAN_WEBHOOK_URL=

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Sanchez Custom Boxing <orders@example.invalid>"
# Marketing ESP (Klaviyo or Brevo) — not chosen yet
MARKETING_ESP_API_KEY=
# CRM webhook for quotes (spec 04 §3.2)
CRM_WEBHOOK_URL=

# ── Bot protection ────────────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analytics / ads (all consent-gated) ───────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_PERSONAL_API_KEY=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GA4_API_SECRET=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CONVERSION_ACTION_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
